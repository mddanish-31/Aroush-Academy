{
  "name": "aroush-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:attendance": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-attendance.ts",
    "test:timetable": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-timetable.ts",
    "test:online-classes": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-online-classes.ts",
    "test:examinations": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-examinations.ts",
    "test:cross-portal": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-cross-portal.ts",
    "test:digital-id": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-digital-id.ts",
    "test:audit-logs": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-audit-logs.ts",
    "test:fees": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-fees.ts",
    "test:browser-qa": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-browser-qa-flows.ts",
    "test:content": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-content.ts",
    "test:contrast": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-contrast.ts",
    "test:media": "node --experimental-strip-types --loader ./scripts/loader.mjs scripts/verify-media-urls.ts",
    "qa:browser": "node scripts/qa-browser.mjs",
    "db:ping": "node --env-file=.env.local --import tsx scripts/db-ping.ts",
    "db:generate": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit studio",
    "db:migrate:test": "node --env-file=.env.local --import tsx scripts/db-migrate-test.ts",
    "db:test:phase-a": "node --env-file=.env.local --import tsx scripts/db-test-phase-a.ts",
    "auth:timing": "node --env-file=.env.local --import tsx scripts/scrypt-timing.ts",
    "db:seed:test": "node --env-file=.env.local --import tsx scripts/db-seed.ts",
    "db:seed:main": "node --env-file=.env.local --import tsx scripts/db-seed.ts --main",
    "db:test:auth": "node --env-file=.env.local --import tsx scripts/db-test-auth.ts",
    "dev:test-server": "node scripts/dev-test-server.mjs",
    "test:auth-http": "node --env-file=.env.local scripts/test-auth-http.mjs",
    "db:test:admissions": "node --env-file=.env.local --import tsx scripts/db-test-admissions.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "^16.4.1",
    "qrcode-svg": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^20",
    "@types/qrcode-svg": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
